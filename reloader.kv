BoxLayout:
	orientation: "vertical"
	canvas.before: 
		Color:
			rgba: rgba("FBFBFB")
		Rectangle:
			pos: self.pos
			size: self.size
	ColoredBox:
		orientation: "horizontal"
		ColoredBox:
			bg_color: 1,0,1,1
			size_hint: None, 1
			size: dp(20), dp(10)
		ColoredBox:
			bg_color: 0,0,1,1
	ColoredBox:
		bg_color: rgba("FFFFFF")
		size_hint: 1,None
		height: dp(714)
		orientation: "vertical"
			# logos_google-icon.png
		ColoredBox:
			bg_color: 1,0,0,1
		ColoredBox:
			bg_color: 0,1,0,1
		ColoredBox:
			bg_color: 0,0,1,1

<ColoredBox@BoxLayout>:
	bg_color: 1,1,1,1
	canvas.before: 
		Color:
			rgba: self.bg_color
		Rectangle:
			pos: self.pos
			size: self.size

<LabelB@Button>:
	background_normal: ''
    background_down: ''
    background_disabled_normal: ''
    background_disabled_down: ''
    background_color: 0, 0, 0, 0
